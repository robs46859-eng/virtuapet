# Safe names only. Never put real credentials in this file or commit a populated .env.
VIRTUAPET_ENV=development
HOST=0.0.0.0
PORT=8080
PUBLIC_API_BASE_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL 16. Use a different least-privilege account and database per environment.
DATABASE_URL=postgresql://virtuapet_app:replace-locally@127.0.0.1:5432/virtuapet
# Bootstrap-only values. Do not expose DATABASE_ADMIN_URL to the running API.
DATABASE_ADMIN_URL=postgresql://postgres:replace-locally@127.0.0.1:5432/postgres
VIRTUAPET_DATABASE=virtuapet
VIRTUAPET_MIGRATOR_ROLE=virtuapet_migrator
VIRTUAPET_MIGRATOR_PASSWORD=replace-with-a-unique-migrator-password
VIRTUAPET_APP_ROLE=virtuapet_app
VIRTUAPET_APP_PASSWORD=replace-with-a-unique-runtime-password
VIRTUAPET_READONLY_ROLE=virtuapet_readonly
VIRTUAPET_READONLY_PASSWORD=replace-with-a-unique-readonly-password

# Generate a unique random value of at least 32 bytes for each environment.
CLINICAL_TWIN_SIGNING_KEY=replace-with-a-unique-random-value-at-least-32-bytes

# Production identity provider values. DEV_API_TOKEN is local development only.
OIDC_ISSUER=https://identity.example.invalid
OIDC_AUDIENCE=virtuapet-api
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
DEV_API_TOKEN=replace-locally

# Integration bridges default OFF. Configure in the API secret store, never the website.
# Tenant UUID -> dedicated Layer8 tenant API key (scope virtuapet:policy). No global fallback.
LAYER8_POLICY_ENABLED=false
LAYER8_POLICY_ENDPOINT=
LAYER8_POLICY_CREDENTIALS_JSON=
LAYER8_POLICY_ISSUER=
LAYER8_POLICY_AUDIENCE=
LAYER8_POLICY_PUBLIC_JWKS=
# Short-lived Layer8 account proof exchange. Distinct link and policy audiences.
# DATABASE_URL must point to migrated PostgreSQL; runtime has no memory fallback.
LAYER8_IDENTITY_LINKS_ENABLED=false
LAYER8_LINK_ISSUER=
LAYER8_LINK_AUDIENCE=
LAYER8_LINK_KEY_ID=
LAYER8_LINK_JWKS_JSON=
# 32 random bytes encoded as base64; encryption key is separate from signing keys.
INTEGRATION_LINK_ENCRYPTION_KEY_BASE64=
# Enabling flags alone cannot authorize provider data. A server-owned,
# consent-checked per-user identity-link resolver is also required in code.
PAWSOME3D_PREVIEW_ENABLED=false
PAWSOME3D_BASE_URL=
PAWSOME3D_ASSET_ORIGINS=
PAWPATH_ENABLED=false
PAWPATH_BASE_URL=
